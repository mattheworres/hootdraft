# Copy to docker/.env and adjust: cp docker/.env.example docker/.env
# Read by the `db` container (MARIADB_*) and the `php` container (everything else, which overrides .env).

# --- MariaDB (read only when the data volume is first created) ---
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=phpdraft
MARIADB_USER=phpdraft
MARIADB_PASSWORD=change-me

# --- App (must match the MARIADB_* values above) ---
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-to-a-random-string
DB_HOST=db
DB_PORT=3306
DB_NAME=phpdraft
DB_USER=phpdraft
DB_PASS=change-me
MAIL_DEVELOPMENT=1
