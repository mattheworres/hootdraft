# Default (non-secret) settings, committed. Real values and secrets go in .env.local (git-ignored),
# or in real environment variables, which always win. Replaces appsettings.php.
# (Under APP_ENV=test, i.e. phpunit, .env.local is NOT read; use .env.test.local there.)

APP_ENV=prod
APP_DEBUG=0
# Generate with: php -r 'echo bin2hex(random_bytes(16));'
APP_SECRET=

# Database (also read by phinx.php for migrations)
DB_DRIVER=pdo_mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=phpdraft
DB_USER=phpdraft
DB_PASS=

CACHE_SECONDS=3600
CACHE_PATH=/tmp

# Google reCAPTCHA secret key
RECAPTCHA_SECRET=

# Mail. MAIL_DEVELOPMENT=1 sends to a local catcher (e.g. MailHog) on MAIL_SERVER:MAIL_PORT
MAIL_DEVELOPMENT=0
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USER=
MAIL_PASS=
MAIL_USE_ENCRYPTION=0
MAIL_ENCRYPTION=tls

APP_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api
DRAFT_PASSWORD_HEADER=X-PhpDraft-DraftPassword
SET_CSV_TIMEOUT=0
