# Settings of the E2E stack, committed. Nothing here is a secret: the stack holds test data only and
# listens on 127.0.0.1. Read by the `db` container (MARIADB_*) and the `php` container (everything else).

# --- MariaDB (read only when the data volume is first created) ---
MARIADB_ROOT_PASSWORD=e2e-root
MARIADB_DATABASE=hootdraft_e2e
MARIADB_USER=hootdraft_e2e
MARIADB_PASSWORD=e2e-pass

# --- App (must match the MARIADB_* values above) ---
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=e2e-secret-not-used-anywhere-else
DB_HOST=db
DB_PORT=3306
DB_NAME=hootdraft_e2e
DB_USER=hootdraft_e2e
DB_PASS=e2e-pass

APP_BASE_URL=http://localhost:8100
API_BASE_URL=http://localhost:8100/api

# Google's public reCAPTCHA test keys: each check passes. The site key is in client-config.js.
# https://developers.google.com/recaptcha/docs/faq#id-like-to-run-automated-tests-with-recaptcha.-what-should-i-do
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

MAIL_DEVELOPMENT=1
MAIL_SERVER=mailpit
MAIL_PORT=1025
MAIL_USER=noreply@hootdraft.local

# The API caches each Draft row. One second lets the timestamp helper wait for a direct write to show.
CACHE_SECONDS=1
