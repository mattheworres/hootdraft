{
    "type": "project",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^4.4",
        "egulias/email-validator": "^4.0",
        "google/recaptcha": "^1.5",
        "phpfastcache/phpfastcache": "^9.2",
        "phpmailer/phpmailer": "^7.0",
        "robmorgan/phinx": "^0.16",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "deployer/deployer": "^8.0",
        "squizlabs/php_codesniffer": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "HootDraft\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HootDraft\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "require": "8.1.*"
        }
    }
}
