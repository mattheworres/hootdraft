# HootDraft settings (generated by `dep setup`). Secrets live here; never commit this file.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET="{hootdraft.appSecret}"

DB_DRIVER=pdo_mysql
DB_HOST="{hootdraft.dbHost}"
DB_PORT={hootdraft.dbPort}
DB_NAME="{hootdraft.dbName}"
DB_USER="{hootdraft.dbUser}"
DB_PASS="{hootdraft.dbPass}"

CACHE_SECONDS={hootdraft.cacheSeconds}
CACHE_PATH="{hootdraft.cachePath}"

RECAPTCHA_SECRET="{hootdraft.recaptchaPrivateKey}"

MAIL_DEVELOPMENT=0
MAIL_SERVER="{hootdraft.mailServer}"
MAIL_PORT={hootdraft.mailPort}
MAIL_USER="{hootdraft.mailUser}"
MAIL_PASS="{hootdraft.mailPass}"
MAIL_USE_ENCRYPTION=1
MAIL_ENCRYPTION=tls

APP_BASE_URL="{hootdraft.appBaseUrl}"
API_BASE_URL="{hootdraft.apiBaseUrl}"
